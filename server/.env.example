# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB
# No local MongoDB? Use in-memory (dev only; data lost on restart):
MONGO_DEV_MEMORY=1
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/stj_db
# When MONGO_DEV_MEMORY=1, MONGODB_URI is ignored.
MONGODB_URI=mongodb://127.0.0.1:27017/stj_db
# Atlas example (URL-encode special characters in the password: @ %40, # %23, etc.):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/stj_db?retryWrites=true&w=majority
# Optional if the database name is not in the URI path:
# MONGODB_DB_NAME=stj_db

# JWT Authentication (required)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Groq AI (optional; used for Module 2 narratives only)
# If GROQ_API_KEY is not set, the backend returns deterministic Josiyam results only.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-70b-versatile
